<local:SettingsPageBase
    x:Class="MuggleBuds.App.Views.Settings.BudsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MuggleBuds.App.Views.Settings"
    xmlns:views="using:MuggleBuds.App.Views"
    xmlns:vm="using:MuggleBuds.Presentation.ViewModels">

    <ContentControl Style="{StaticResource SettingsPageStyle}">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Audio Settings" />

            <!-- Disconnected: settings can't be read or changed without the control link -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.SelectedHeadset.ShowDisconnectedWarning, Mode=OneWay, FallbackValue=True}"
                Message="{x:Bind ViewModel.SelectedHeadset.DisconnectedMessage, Mode=OneWay, FallbackValue='No CMF Buds paired. Pair them in Bluetooth settings.'}"
                Severity="Informational" />

            <!-- Error: a change that didn't go through -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.SelectedHeadset.HasError, Mode=OneWay, FallbackValue=False}"
                Message="{x:Bind ViewModel.SelectedHeadset.ErrorMessage, Mode=OneWay}"
                Severity="Warning" />

            <ContentControl IsEnabled="{x:Bind ViewModel.SelectedHeadset.IsConnected, Mode=OneWay, FallbackValue=False}" Style="{StaticResource SectionStyle}">
                <StackPanel Spacing="8">

                    <!-- Listening Mode -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Listening mode" />
                                <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="The sound profile your buds apply" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="170"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Listening mode"
                                ItemsSource="{x:Bind vm:HeadsetViewModel.ListeningModeNames}"
                                SelectedIndex="{x:Bind ViewModel.SelectedHeadset.ListeningModeIndex, Mode=TwoWay, FallbackValue=-1}" />
                        </Grid>
                    </Border>

                    <!-- Noise Cancellation Level -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Noise cancellation level" />
                                <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Choosing a level turns noise cancellation on" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="150"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Noise cancellation level"
                                ItemsSource="{x:Bind vm:HeadsetViewModel.AncStrengthNames}"
                                SelectedIndex="{x:Bind ViewModel.SelectedHeadset.AncStrengthIndex, Mode=TwoWay, FallbackValue=0}" />
                        </Grid>
                    </Border>

                    <!-- In-ear Detection -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <views:SettingToggleRow
                            IsOn="{x:Bind ViewModel.SelectedHeadset.InEarDetection, Mode=TwoWay, FallbackValue=False}"
                            Subtitle="Pauses and resumes media when you take a bud out or put it back"
                            Title="In-ear detection" />
                    </Border>

                    <!-- Low Latency -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <views:SettingToggleRow
                            IsOn="{x:Bind ViewModel.SelectedHeadset.LowLatency, Mode=TwoWay, FallbackValue=False}"
                            Subtitle="Reduces audio delay for games and video"
                            Title="Low latency mode" />
                    </Border>

                    <!-- Enhanced Bass -->
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <views:SettingToggleRow
                            IsOn="{x:Bind ViewModel.SelectedHeadset.EnhancedBass, Mode=TwoWay, FallbackValue=False}"
                            Subtitle="Boosts low frequencies, at the level set in the Nothing X app"
                            Title="Enhanced bass" />
                    </Border>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ContentControl>
</local:SettingsPageBase>
