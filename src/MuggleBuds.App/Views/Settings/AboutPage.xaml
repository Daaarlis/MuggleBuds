<local:SettingsPageBase
    x:Class="MuggleBuds.App.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MuggleBuds.App.Views.Settings">

    <ContentControl Style="{StaticResource SettingsPageStyle}">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="About" />

            <!-- App -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="32"
                        Glyph="&#xE7F6;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="MuggleBuds" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind local:AboutPage.VersionText}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                            <Run Text="A personal CMF Buds Pro 2 port of MagicBuds by " /><Hyperlink NavigateUri="https://github.com/artistro08">
                                artistro08
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Repository -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="MuggleBuds source code, releases and issues."
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Grid.Column="1"
                        Content="View on GitHub"
                        NavigateUri="https://github.com/Daaarlis/MuggleBuds" />
                </Grid>
            </Border>

            <!-- Credits -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="CMF Buds protocol details based on ear-web (AGPL-3.0)."
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Grid.Column="1"
                        Content="View on GitHub"
                        NavigateUri="https://github.com/radiance-project/ear-web" />
                </Grid>
            </Border>
        </StackPanel>
    </ContentControl>
</local:SettingsPageBase>
